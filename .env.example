# Copiá a .env.local y completá los valores (Supabase → Project Settings → API).

# En Vercel: Project → Settings → Environment Variables (mismas claves; Production + Preview).



NEXT_PUBLIC_SUPABASE_URL=

NEXT_PUBLIC_SUPABASE_ANON_KEY=



# Solo servidor (nunca exponer al cliente). Auth → service_role

SUPABASE_SERVICE_ROLE_KEY=



# Storage: migración `20260414180000_storage_sorjuana.sql` crea el bucket público `sorjuana` (imágenes / videos).



# Una vez: npm run seed:admin (luego podés borrar estas tres del archivo)

SUPABASE_SEED_EMAIL=

SUPABASE_SEED_USERNAME=

SUPABASE_SEED_PASSWORD=

SUPABASE_SEED_ROLE=admin



# WhatsApp Cloud API (Meta): envío automático al marcar “Pago” en Ventas (sin abrir wa.me).

# Sin estas variables, se abre wa.me con el texto listo (hay que tocar “Enviar” en WhatsApp).

# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started

WHATSAPP_CLOUD_ACCESS_TOKEN=

WHATSAPP_CLOUD_PHONE_NUMBER_ID=

# Opcional (default: v21.0)

# WHATSAPP_CLOUD_API_VERSION=v21.0

# Por defecto el aviso de “Pago” va a +541131199882. Para otro número:

# WHATSAPP_PAYMENT_NOTIFY_TO=5491112345678



# Cotización de envío — ShipNow (GET /shipping_options, Bearer token)

# Token: solicitá a developers@shipnow.com.ar · Doc: https://shipnow.stoplight.io/docs/shipnow-api/cysyd7s2172ws-shipnow

SHIPNOW_ACCESS_TOKEN=

# Producción (default si omitís): https://api.shipnow.com.ar

# SHIPNOW_API_BASE_URL=https://api.shipnow.com.ar

# Peso total del paquete usado para cotizar (gramos; la API lo exige)

# SHIPNOW_WEIGHT_GRAMS=1500

# ship_pap = domicilio, ship_pas = sucursal; podés combinar: ship_pap,ship_pas

# SHIPNOW_TYPES=ship_pap

#

# Alternativa: cotizador HTTP propio (solo si NO usás ShipNow)

# SHIPPING_QUOTE_URL=

# SHIPPING_API_BASE_URL=

# SHIPPING_QUOTE_PATH=

